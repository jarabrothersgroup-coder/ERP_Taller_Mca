# ── AutomotiveOS Environment Variables ──────────────────
# Copy to .env.local for local dev, or set in Vercel/Railway dashboard

# ── Backend ────────────────────────────────────────────
# Fastify backend URL (used by Next.js rewrites + auth)
AUTH_BACKEND_URL=http://localhost:4000

# ── Clerk Authentication ──────────────────────────────
# Get keys from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
CLERK_SECRET_KEY=sk_test_your-key-here
# Clerk paths (optional, defaults work)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── Database (Neon/Supabase Serverless) ────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Tenant Defaults ────────────────────────────────────
NEXT_PUBLIC_DEFAULT_TENANT=demo

# ── Supabase (Storage / Realtime) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── WhatsApp Business API ──────────────────────────────
WHATSAPP_API_TOKEN=your-wa-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id

# ── SIFEN (DNIT Electronic Invoicing) ──────────────────
SIFEN_ENV=testing
SIFEN_TOKEN=your-sifen-token

# ── SendGrid (Email) ──────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@taller.com

# ── Vercel (Frontend Deploy) ──────────────────────────
# Only needed if deploying frontend to Vercel separately
# VERCEL_ORG_ID=your-org-id
# VERCEL_PROJECT_ID=your-project-id
