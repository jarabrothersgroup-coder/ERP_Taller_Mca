# ── AutomotiveOS Environment Variables ──────────────────
# Copy to .env.local for local dev, or set in Vercel/Railway dashboard

# ── Backend ────────────────────────────────────────────
# Backend host/port for Next.js API rewrites (next.config.mjs).
# ⚠️  El puerto se hornea en el build: si cambia, hay que rebuildear.
# ⚠️  NO usar 3000 (es el puerto del propio web server → loop infinito).
# El backend de este proyecto corre en 4000 por defecto (ver scripts de E2E).
BACKEND_HOST=localhost
BACKEND_PORT=4000

# ── Auth ───────────────────────────────────────────────
# Autenticación JWT custom (backend). No se usa Clerk.

# ── Database (Neon/Supabase Serverless) ────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Tenant Defaults ────────────────────────────────────
NEXT_PUBLIC_DEFAULT_TENANT=demo

# ── Supabase (Storage / Realtime) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── WhatsApp Business API ──────────────────────────────
WHATSAPP_API_TOKEN=your-wa-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id

# ── SIFEN (DNIT Electronic Invoicing) ──────────────────
SIFEN_ENV=testing
SIFEN_TOKEN=your-sifen-token

# ── SendGrid (Email) ──────────────────────────────────
SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@taller.com

# ── Vercel (Frontend Deploy) ──────────────────────────
# Only needed if deploying frontend to Vercel separately
# VERCEL_ORG_ID=your-org-id
# VERCEL_PROJECT_ID=your-project-id
