{
  "dashboard": {
    "title": "AutomotiveOS ERP - Monitoreo PCSERVER",
    "uid": "erp-monitoring-pcserver",
    "timezone": "America/Asuncion",
    "editable": true,
    "time": { "from": "now-6h", "to": "now" },
    "refresh": "30s",
    "tags": ["erp", "automotiveos", "pcserver"],
    "panels": [
      {
        "id": 1, "title": "Estado del Sistema", "type": "stat",
        "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "mappings": [{ "options": { "1": { "color": "green", "text": "OK" }, "0": { "color": "red", "text": "DOWN" } }, "type": "value" }],
            "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "green", "value": 1 }] }
          }
        },
        "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
        "targets": [{ "expr": "up{job=~\"node|prometheus\"}", "legendFormat": "{{job}}", "refId": "A" }]
      },
      {
        "id": 2, "title": "CPU Usage", "type": "gauge",
        "gridPos": { "h": 4, "w": 3, "x": 3, "y": 0 },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] },
            "unit": "percent", "max": 100, "min": 0
          }
        },
        "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
        "targets": [{ "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU", "refId": "A" }]
      },
      {
        "id": 3, "title": "Memory Usage", "type": "gauge",
        "gridPos": { "h": 4, "w": 3, "x": 6, "y": 0 },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] },
            "unit": "percent", "max": 100, "min": 0
          }
        },
        "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
        "targets": [{ "expr": "100 - ((node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100)", "legendFormat": "RAM", "refId": "A" }]
      },
      {
        "id": 4, "title": "Disk Usage (/data)", "type": "gauge",
        "gridPos": { "h": 4, "w": 3, "x": 9, "y": 0 },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "orange", "value": 80 }, { "color": "red", "value": 95 }] },
            "unit": "percent", "max": 100, "min": 0
          }
        },
        "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
        "targets": [{ "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/data\"} / node_filesystem_size_bytes{mountpoint=\"/data\"}) * 100)", "legendFormat": "Disk /data", "refId": "A" }]
      },
      {
        "id": 5, "title": "Load Average", "type": "gauge",
        "gridPos": { "h": 4, "w": 3, "x": 12, "y": 0 },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "orange", "value": 2 }, { "color": "red", "value": 4 }] },
            "unit": "none", "min": 0
          }
        },
        "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true },
        "targets": [{ "expr": "node_load15", "legendFormat": "Load 15m", "refId": "A" }]
      },
      {
        "id": 6, "title": "Uptime (días)", "type": "stat",
        "gridPos": { "h": 4, "w": 3, "x": 15, "y": 0 },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "orange", "value": 1 }, { "color": "green", "value": 7 }] }
          }
        },
        "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
        "targets": [{ "expr": "(time() - node_boot_time_seconds) / 86400", "legendFormat": "días", "refId": "A" }]
      },
      {
        "id": 7, "title": "CPU Evolution", "type": "timeseries",
        "gridPos": { "h": 6, "w": 8, "x": 0, "y": 4 },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "custom": { "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" },
            "color": { "mode": "palette-classic" }
          }
        },
        "options": { "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom" } },
        "targets": [{ "expr": "100 - (avg by (cpu)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU {{cpu}}", "refId": "A" }]
      },
      {
        "id": 8, "title": "Memory Evolution", "type": "timeseries",
        "gridPos": { "h": 6, "w": 8, "x": 8, "y": 4 },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "custom": { "drawStyle": "line", "fillOpacity": 20, "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never" },
            "color": { "mode": "palette-classic" }
          }
        },
        "options": { "legend": { "calcs": ["mean", "max", "last"], "displayMode": "table", "placement": "bottom" } },
        "targets": [
          { "expr": "node_memory_MemTotal_bytes", "legendFormat": "Total", "refId": "A" },
          { "expr": "node_memory_MemAvailable_bytes", "legendFormat": "Disponible", "refId": "B" }
        ]
      },
      {
        "id": 9, "title": "Disk Space", "type": "bargauge",
        "gridPos": { "h": 6, "w": 8, "x": 16, "y": 4 },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "unit": "percent", "max": 100, "min": 0,
            "color": { "mode": "thresholds" },
            "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] }
          }
        },
        "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
        "targets": [{ "expr": "100 - ((node_filesystem_avail_bytes{fstype!=\"tmpfs\",fstype!=\"devtmpfs\"} / node_filesystem_size_bytes{fstype!=\"tmpfs\",fstype!=\"devtmpfs\"}) * 100)", "legendFormat": "{{mountpoint}}", "refId": "A" }]
      },
      {
        "id": 10, "title": "Network Traffic", "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "unit": "bps",
            "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" },
            "color": { "mode": "palette-classic" }
          }
        },
        "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" } },
        "targets": [
          { "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[5m])", "legendFormat": "RX {{device}}", "refId": "A" },
          { "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m])", "legendFormat": "TX {{device}}", "refId": "B" }
        ]
      },
      {
        "id": 11, "title": "Disk I/O", "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
        "datasource": "Prometheus",
        "fieldConfig": {
          "defaults": {
            "unit": "Bps",
            "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" },
            "color": { "mode": "palette-classic" }
          }
        },
        "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" } },
        "targets": [
          { "expr": "rate(node_disk_read_bytes_total[5m])", "legendFormat": "Lectura {{device}}", "refId": "A" },
          { "expr": "rate(node_disk_written_bytes_total[5m])", "legendFormat": "Escritura {{device}}", "refId": "B" }
        ]
      }
    ],
    "schemaVersion": 36,
    "style": "dark"
  },
  "overwrite": true
}
