# ─────────────────────────────────────────────────────────
# AutomotiveOS Cloud ERP — Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your production values.
# NEVER commit .env to version control.
#
# Uso con Docker:
#   cp .env.example .env
#   docker compose -f docker-compose.onpremise.yml up -d

# ─── Server ─────────────────────────────────────────────
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"          # development | production | test

# ─── Database (PostgreSQL Local) ────────────────────────
DATABASE_URL=postgresql://erp_user:erp_dev_password@100.104.144.92:5432/automotive_os?sslmode=disable

# ─── Local Filesystem Storage ───────────────────────────
# Ruta donde se almacenan archivos subidos (fotos DVI, etc.)
STORAGE_PATH="/data/erp-storage"

# ─── JWT Authentication ────────────────────────────────
# Secreto para firmar tokens JWT — CAMBIAR EN PRODUCCIÓN
JWT_SECRET="change-me-in-production"

# ─── Multi-Tenant ──────────────────────────────────────
TENANT_SCHEMA_PREFIX="tenant_"
# Per-request tenant context (RLS defense-in-depth): dedicates a connection
# per request and sets app.current_tenant. Safe con RLS fail-closed (0019).
ENABLE_REQUEST_TENANT_CONTEXT="true"

# ─── Logging ────────────────────────────────────────────
LOG_LEVEL="info"                 # trace | debug | info | warn | error | fatal

# ─── Metrics Endpoint Protection ────────────────────────
# Basic auth for /metrics when set (format: base64("user:password").
# When empty, /metrics is public (dev). Set in production for security.
METRICS_BASIC_AUTH=""

# ─── Offline-First (Sync) ──────────────────────────────
SYNC_INTERVAL_MS=30000

# ─── CORS ──────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"

# ─── SIFEN / DNIT — Facturación Electrónica (Paraguay) ─
# Certificado .p12 emitido por DNIT (colocar en /etc/sifen/cert.p12 en prod)
SIFEN_CERT_PATH="/etc/sifen/cert.p12"
SIFEN_CERT_PASS=""
# true = entorno TEST de SIFEN (homologación); false = PRODUCCIÓN (requiere cert real)
SIFEN_USE_TEST=true

# ─── SET/SIFEN Invoice Configuration ────────────
# true = SET invoicing enabled (requires valid .p12 cert in production)
# false = offline/manual invoicing only
SET_CONFIG=false

# ─── Hardware-lock token signing (security-hw) ─
# OBLIGATORIO (>= 32 chars). El sistema NO arranca sin él (fail-closed).
TOKEN_SECRET="change-me-dev-token-secret-32-chars-minimum"

# ─── Clerk (Auth) ───────────────────────────────────────
# Frontend (Next.js): publishable key for client-side Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# Backend (Fastify): secret key for server-side API calls
CLERK_SECRET_KEY=""
# Backend: publishable key for JWKS token verification
CLERK_PUBLISHABLE_KEY=""
# Backend: issuer URL for JWT verification (e.g. "https://clerk.your-app.com")
CLERK_ISSUER=""
# Backend: Clerk API URL (default: https://api.clerk.com)
CLERK_API_URL=""

# ─── Stripe (Billing) ────────────────────────────────────
# Secret key for Stripe API calls (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=""
# Webhook signing secret for verifying Stripe webhooks
STRIPE_WEBHOOK_SECRET=""
# Stripe mode: "test" (default) se sirve con STRIPE_SECRET_KEY/WEBHOOK;
# "live" requiere STRIPE_SECRET_KEY_LIVE + STRIPE_WEBHOOK_SECRET_LIVE
STRIPE_MODE="test"
STRIPE_SECRET_KEY_LIVE=""
STRIPE_WEBHOOK_SECRET_LIVE=""

# ─── Thinkcar (Diagnostic Email Notifications) ────────
# Email user (Gmail) for sending Thinkcar diagnostic alerts
THINKCAR_EMAIL_USER=""
# App password for the Gmail account (not the regular password)
THINKCAR_EMAIL_PASSWORD=""
# Optional: different recipient for alerts (defaults to THINKCAR_EMAIL_USER)
THINKCAR_ALERT_RECIPIENT=""

# ─── PagosPy (Paraguay Online Payments) ────────────────
# API key for PagosPy payment gateway (local Paraguay payments)
PAGOSPY_API_KEY=""
# API base URL (default: https://api.pasarelapy.com/v1)
PAGOSPY_API_URL="https://api.pasarelapy.com/v1"

# ─── Application Base URL ──────────────────────────────
# Required in production — used in email redirects, payment callbacks, etc.
APP_URL="http://localhost:3000"

# ─── RAG / OpenAI (Embeddings) ────────────────────────
OPENAI_API_KEY=""

# ─── WhatsApp / Evolution API ──────────────────────────
# URL del servidor Evolution API (Docker: http://evolution-api:8080)
WHATSAPP_API_URL="http://localhost:8080"
# API Key para autenticación con Evolution API
WHATSAPP_API_KEY="evolution-dev-api-key-change-me"

# ─── Resend (Email Transaccional) ─────────────────────
# API Key de Resend para envío de emails transaccionales (facturas, presupuestos, recordatorios)
# Obtener en: https://resend.com/api-keys
RESEND_API_KEY=""

# ─── Twenty CRM ────────────────────────────────────────
# URL del servidor Twenty CRM (Docker: http://twenty-crm:3000)
TWENTY_API_URL="http://localhost:3001"
# API Key de Twenty CRM (Settings → API Keys en Twenty)
TWENTY_API_KEY=""
# GraphQL endpoint (opcional, por defecto /graphql)
TWENTY_GRAPHQL_URL="http://localhost:3001/graphql"

# ─── Docker Compose — PostgreSQL ───────────────────────
POSTGRES_PORT=5432
POSTGRES_DB="automotive_os"
POSTGRES_USER="erp_user"
POSTGRES_PASSWORD="erp_dev_password"

# ─── Docker Compose — Redis ────────────────────────────
REDIS_PORT=6379

# ─── Grafana / Monitoreo ────────────────────────────────
# Password del rol de solo lectura grafana_reader en PostgreSQL.
# Provisionar el rol con: scripts/provision-grafana-reader.sh
# Datasource: deploy/grafana/provisioning/datasources/datasource.yml
PG_GRAFANA_PASSWORD=""
# URL de PostgreSQL para el datasource de Grafana (Grafana NO soporta
# default `:-` en provisioning). Grafana en el host → localhost:5432;
# Grafana containerizado en la red del compose → postgres:5432
PG_DATASOURCE_URL="localhost:5432"
# Password del admin de Grafana. Cambiar SIEMPRE en producción (default débil).
# Solo aplica en el primer init del contenedor; para cambiar en una instancia
# existente usar la API: PUT /api/admin/users/{id}/password
GRAFANA_ADMIN_PASSWORD=""
# Alertas (deploy/grafana/provisioning/alerting/): webhook de notificación
# (Telegram/Teams/Slack). El compose usa un default no vacío si no se define;
# en producción poner la URL real del bot/canal.
# NOTA: los umbrales de las reglas (facturas vencidas, saldo mínimo) son
# valores fijos en rules.yml — Grafana no expande env vars dentro del modelo
# de reglas de alerta (grafana#54984).
ALERT_WEBHOOK_URL="https://hooks.example.com/grafana"
REDIS_URL="redis://redis:6379"
REDIS_PASSWORD="erp_redis_dev_password"

# ─── Docker Compose — Twenty CRM ──────────────────────
TWENTY_PORT=3001
TWENTY_DB="twenty_crm"
TWENTY_SERVER_URL="http://localhost:3001"
TWENTY_FRONT_BASE_URL="http://localhost:3001"
TWENTY_ACCESS_TOKEN_SECRET="twenty-dev-access-secret-change-me"
TWENTY_LOGIN_TOKEN_SECRET="twenty-dev-login-secret-change-me"
TWENTY_REFRESH_TOKEN_SECRET="twenty-dev-refresh-secret-change-me"
TWENTY_FILE_TOKEN_SECRET="twenty-dev-file-secret-change-me"

# ─── Docker Compose — Evolution API ────────────────────
EVOLUTION_API_PORT=8080
EVOLUTION_DB="evolution_api"
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_WEBHOOK_URL="http://erp:3000/api/v1/whatsapp/webhook"
EVOLUTION_VERIFY_TOKEN=""
